# Копия в .env. Ключи cisdbot сюда не класть, если бот уже торгует на том счёте.
# Токен телеграма тоже отдельный: один токен на два бота нельзя.

BYBIT_API_KEY=
BYBIT_API_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY=

# 1 = тень, ордеров нет. 0 = живой режим сразу после запуска.
PAPER_TRADING=1
RISK_PCT=1
LEVERAGE=20
PAPER_BALANCE=100
